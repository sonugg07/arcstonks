# ArcStonks Environment Variables Example

# Firebase Configuration
# Obtain these from: Firebase Console -> Project Settings -> General -> Your apps -> ArcStonks Web
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=arcstonks.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=arcstonks
VITE_FIREBASE_STORAGE_BUCKET=arcstonks.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here

# (Optional) Next.js public prefixes - also supported automatically
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=arcstonks
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Admin Authentication
ADMIN_PASSWORD=arcstonks@9888
ADMIN_JWT_SECRET=arcstonks_super_secret_jwt_key_999444
ADMIN_EMAILS=sonu9888123@gmail.com

# Cloudflare Turnstile Configuration
NEXT_PUBLIC_CLOUDFLARE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
CLOUDFLARE_TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
